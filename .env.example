MH_ENVIRONMENT=development
MH_APP_NAME=Marketplace Hub API
MH_DATABASE_URL=postgresql+psycopg://marketplace_hub:marketplace_hub@postgres:5432/marketplace_hub
MH_REDIS_URL=redis://redis:6379/0
MH_DB_POOL_SIZE=5
MH_DB_MAX_OVERFLOW=10
MH_READINESS_TIMEOUT_SECONDS=2
MH_SESSION_COOKIE_NAME=mh_session
MH_SESSION_TTL_HOURS=12
MH_LOGIN_ATTEMPT_LIMIT=5
MH_LOGIN_WINDOW_SECONDS=900
MH_ALLOWED_ORIGINS=http://localhost:3000
# Required for new marketplace credential writes. Preserve the existing
# MARKETPLACE_HUB_MASTER_KEY when importing encrypted legacy accounts.
MH_MASTER_KEY=
INTERNAL_API_URL=http://api:8000
