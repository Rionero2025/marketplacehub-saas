# Locale / Docker Compose only. Never commit a real .env file.
MARKETPLACE_HUB_DB_ENGINE=postgresql
DATABASE_URL=postgresql://marketplace_hub:change-me@db:5432/marketplace_hub
MARKETPLACE_HUB_MASTER_KEY=replace-with-a-long-random-secret
MARKETPLACE_HUB_REQUIRE_AUTH=true
MARKETPLACE_HUB_ADMIN_USERNAME=admin
MARKETPLACE_HUB_ADMIN_PASSWORD=replace-with-a-strong-password
MARKETPLACE_HUB_PG_POOL_MIN=2
MARKETPLACE_HUB_PG_POOL_MAX=12
TZ=Europe/Rome

# v302: evita una query utente ad ogni rerun Streamlit
MARKETPLACE_HUB_SESSION_REFRESH_SECONDS=15

# v307: cache condivisa. Se vuoto, fallback automatico alla cache locale del processo.
MARKETPLACE_HUB_REDIS_URL=
MARKETPLACE_HUB_CACHE_NAMESPACE=marketplacehub:v307
MARKETPLACE_HUB_CACHE_TTL_SECONDS=20
MARKETPLACE_HUB_CACHE_MAX_ENTRIES=2048

# v312: object storage. Default locale per sviluppo; in SaaS usare S3/R2/GCS compatibile S3.
MARKETPLACE_HUB_STORAGE_BACKEND=local
MARKETPLACE_HUB_STORAGE_LOCAL_ROOT=data/object_store
MARKETPLACE_HUB_STORAGE_PREFIX=marketplacehub
MARKETPLACE_HUB_STORAGE_BUCKET=
MARKETPLACE_HUB_STORAGE_ENDPOINT_URL=
MARKETPLACE_HUB_STORAGE_REGION=auto
MARKETPLACE_HUB_STORAGE_ACCESS_KEY=
MARKETPLACE_HUB_STORAGE_SECRET_KEY=

# v314: FastAPI. Il frontend React userà cookie HttpOnly / Bearer session.
MARKETPLACE_HUB_API_HOST=0.0.0.0
MARKETPLACE_HUB_API_PORT=8000
MARKETPLACE_HUB_API_WORKERS=1
MARKETPLACE_HUB_API_SESSION_HOURS=12
MARKETPLACE_HUB_API_REMEMBER_DAYS=30
MARKETPLACE_HUB_COOKIE_SECURE=1
MARKETPLACE_HUB_CORS_ORIGINS=
MARKETPLACE_HUB_API_DOCS=1
# Solo sviluppo/singolo container; in SaaS lasciare 0 e usare tools/run_worker.py.
MARKETPLACE_HUB_API_LOCAL_JOBS=0

# SaaS self-service onboarding (v320)
MARKETPLACE_HUB_PUBLIC_SIGNUP=0
MARKETPLACE_HUB_SIGNUP_INVITE_CODE=
MARKETPLACE_HUB_DEFAULT_TRIAL_DAYS=14
